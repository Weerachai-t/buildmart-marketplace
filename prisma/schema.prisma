generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  CATEGORY_MANAGER
  SALES_ADMIN
  SUPPLIER
  CUSTOMER
  LOGISTICS_PARTNER
}
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
enum SupplierStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}
enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  REJECTED
}
enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PACKED
  IN_DELIVERY
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  BANK_TRANSFER
  QR_PAYMENT
  CREDIT_CARD
  CORPORATE_CREDIT
}
enum PaymentStatus {
  PENDING
  VERIFYING
  PAID
  FAILED
  REFUNDED
}

enum RfqStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  QUOTING
  CANCELLED
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  phone String?
  status UserStatus @default(ACTIVE)
  roles UserRole[]
  supplier Supplier?
  accounts Account[]
  sessions Session[]
  addresses Address[]
  orders Order[]
  rfqs Rfq[] @relation("CustomerRfqs")
  reviewedRfqs Rfq[] @relation("ReviewedRfqs")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id String @id @default(cuid())
  code RoleCode @unique
  name String
  users UserRole[]
  permissions RolePermission[]
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  name String
  module String
  action String
  roles RolePermission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Supplier {
  id String @id @default(cuid())
  ownerId String @unique
  companyName String
  slug String @unique
  taxId String?
  phone String?
  province String?
  status SupplierStatus @default(PENDING)
  owner User @relation(fields: [ownerId], references: [id])
  products Product[]
  warehouses Warehouse[]
  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  products Product[]
  attributes CategoryAttribute[]
}

model Brand {
  id String @id @default(cuid())
  name String
  slug String @unique
  logoUrl String?
  products Product[]
}

model Product {
  id String @id @default(cuid())
  supplierId String
  categoryId String
  brandId String?
  sku String
  name String
  slug String @unique
  description String?
  unit String
  basePrice Decimal @db.Decimal(12, 2)
  minOrderQty Decimal @default(1) @db.Decimal(12, 2)
  status ProductStatus @default(DRAFT)
  supplier Supplier @relation(fields: [supplierId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  brand Brand? @relation(fields: [brandId], references: [id])
  images ProductImage[]
  inventory Inventory[]
  attributes ProductAttributeValue[]
  priceTiers ProductPriceTier[]
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([supplierId, sku])
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  url String
  altText String?
  sortOrder Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model AttributeDefinition {
  id String @id @default(cuid())
  code String @unique
  name String
  dataType String
  unit String?
  filterable Boolean @default(true)
  categories CategoryAttribute[]
  values ProductAttributeValue[]
}

model CategoryAttribute {
  categoryId String
  attributeId String
  required Boolean @default(false)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  @@id([categoryId, attributeId])
}

model ProductAttributeValue {
  productId String
  attributeId String
  valueText String?
  valueNumber Decimal?
  valueJson Json?
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id])
  @@id([productId, attributeId])
}

model ProductPriceTier {
  id String @id @default(cuid())
  productId String
  minQty Decimal @db.Decimal(12, 2)
  maxQty Decimal? @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id String @id @default(cuid())
  supplierId String
  name String
  province String
  address String
  supplier Supplier @relation(fields: [supplierId], references: [id])
  inventory Inventory[]
}

model Inventory {
  id String @id @default(cuid())
  warehouseId String
  productId String
  quantity Decimal @default(0)
  reservedQty Decimal @default(0)
  safetyStock Decimal @default(0)
  reorderPoint Decimal @default(0)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@unique([warehouseId, productId])
}

model Address {
  id String @id @default(cuid())
  userId String
  recipient String
  phone String
  address1 String
  district String
  province String
  postalCode String
  isDefault Boolean @default(false)
  user User @relation(fields: [userId], references: [id])
  orders Order[]
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  customerId String
  addressId String
  status OrderStatus @default(DRAFT)
  subtotal Decimal @db.Decimal(12, 2)
  shippingFee Decimal @default(0)
  tax Decimal @default(0)
  total Decimal @db.Decimal(12, 2)
  customer User @relation(fields: [customerId], references: [id])
  address Address @relation(fields: [addressId], references: [id])
  items OrderItem[]
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  quantity Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id String @id @default(cuid())
  orderId String
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(12, 2)
  transactionId String? @unique
  evidenceUrl String?
  order Order @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model Rfq {
  id String @id @default(cuid())
  rfqNumber String @unique
  customerId String
  projectName String
  customerType String
  province String
  deliveryDate DateTime?
  description String
  boqFileName String?
  status RfqStatus @default(SUBMITTED)
  approvedById String?
  approvedAt DateTime?
  reviewNote String?
  customer User @relation("CustomerRfqs", fields: [customerId], references: [id])
  approvedBy User? @relation("ReviewedRfqs", fields: [approvedById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String @id
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
